name=zsh/curses
link='if test "x$ac_cv_func_initscr" = xyes && test "x$zsh_cv_path_curses_header" != x; then echo dynamic; else echo no; fi'
load=no

autofeatures="b:zcurses"

objects="curses.o"

:<<\Make
curses.o curses..o: curses_keys.h ../zshcurses.h

curses_keys.h: curses_keys.awk @CURSES_KEYS_H@
	$(AWK) -f $(sdir)/curses_keys.awk @CURSES_KEYS_H@ /dev/null >curses_keys.h

../zshcurses.h: CURSES_HEADER_RULE

CURSES_HEADER_RULE: FORCE
	@cd .. && $(MAKE) $(MAKEDEFS) -f Makemod zshcurses.h

.PHONY: CURSES_HEADER_RULE

clean-here: clean.curses
clean.curses:
	rm -f curses_keys.h
Make
