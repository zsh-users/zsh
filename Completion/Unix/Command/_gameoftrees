_gotadmin() {
  local curcontext="$curcontext" line state

  _arguments -C \
    '1: :->command' \
    '*::arg:->args'

  case $state in
  command)
    _values 'gotadmin command' \
      'init[create a new empty repository]' \
      'info[display information about a repository]' \
      'pack[generate a new pack file and pack index]' \
